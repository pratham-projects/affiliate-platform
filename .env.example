# This demo needs no real environment configuration — the mock layer
# (mock/install.ts) intercepts every request before it reaches the network,
# so there is no live API to point at.
#
# NEXT_PUBLIC_API_BASE_URL is kept only because the upstream code reads it
# (lib/api/config.ts) to build request URLs that the mock then matches
# against. It is never actually dialed. Do not put a real backend URL here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

# Set to "0" to disable the mock and run the raw upstream UI against a real
# backend at NEXT_PUBLIC_API_BASE_URL (useful only if you fork this repo to
# develop against the real affiliate-system API). Any other value, or unset,
# keeps the demo mock active — this is the default for this repo.
NEXT_PUBLIC_DEMO=1
